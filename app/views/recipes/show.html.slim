doctype html
html
  head 
    = link_to("My Library", user_libraries_path(@user.id))
    = button_to("Log Out", session_path(@user.id), method: :delete)
  body
    h1 = @recipe.name
    section id="basic_info_#{@recipe.id}"
      p = @recipe.description
      p = "Chapter: #{@recipe.chapter.name}"
      p = "Page #{@recipe.page}"
      p = display_servings(@recipe)
      p = display_prep_time(@recipe)
    section id="meal_characteristics_#{@recipe.id}"
      - if @recipe.meal_type || @recipe.meal_time != [] || @recipe.food_group
        p Characteristics:
        p = @recipe.meal_type
        p = @recipe.meal_time.join(" ")
        p = @recipe.food_group
    section id="instructions_#{@recipe.id}"
      - if @recipe.instructions
        p Instructions:
        p = @recipe.instructions